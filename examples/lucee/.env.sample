# PeopleSoft App Server connection — read by edu.apu.pssdk.AppServer.fromEnv()
PS_APPSERVER_HOSTPORT=appserver-host.example.edu:9000
PS_APPSERVER_USERNAME=PS_API_USER
PS_APPSERVER_PASSWORD=changeme
# Optional, only if your domain uses a domain connection password
# PS_APPSERVER_DOMAINPW=

# PeopleTools-matched PSJOA jar version, e.g. 8.60.05 (build-time only)
PSJOA_JAR_VERSION=8.60.05
